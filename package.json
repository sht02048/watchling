{
  "name": "pagent",
  "version": "0.1.0",
  "private": true,
  "description": "A quiet, read-only desktop companion for coding agent sessions",
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "start": "npm run build && electron .",
    "test:unit": "node --experimental-strip-types --test tests/unit/*.test.ts",
    "test:e2e": "npm run build && playwright test",
    "format": "prettier --write src scripts tests package.json tsconfig.json playwright.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^24.0.0",
    "electron": "44.9.2",
    "esbuild": "0.28.2",
    "prettier": "^3.6.0",
    "typescript": "7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
