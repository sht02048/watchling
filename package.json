{
  "name": "watchling",
  "version": "0.1.0",
  "private": true,
  "description": "A quiet, read-only desktop companion for coding agent sessions",
  "license": "MIT",
  "type": "module",
  "main": ".vite/build/main.cjs",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "electron-forge package",
    "build:helper": "swift build --package-path native/hook-emitter -c release",
    "build:local-app": "electron-forge make && WATCHLING_UNFUSED=1 electron-forge package",
    "typecheck": "tsc --noEmit",
    "start": "pnpm build && electron .",
    "dev": "electron-forge start",
    "playground": "node scripts/playground.mjs",
    "test:unit": "node --experimental-strip-types --test tests/unit/*.test.ts",
    "test:integration": "pnpm build:helper && node --experimental-strip-types --test tests/integration/*.test.ts",
    "test:packaged": "pnpm build:local-app && node --experimental-strip-types --test tests/packaged/*.test.ts",
    "test:e2e": "pnpm build && playwright test",
    "format": "prettier --write src scripts tests package.json tsconfig.json playwright.config.ts forge.config.mts vite.*.config.mts"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-dmg": "8.0.1",
    "@electron-forge/plugin-fuses": "8.0.1",
    "@electron-forge/plugin-vite": "8.0.1",
    "@electron-forge/shared-types": "8.0.1",
    "@electron/fuses": "2.1.3",
    "@playwright/test": "1.64.1",
    "@types/node": "^24.0.0",
    "electron": "44.9.2",
    "esbuild": "0.28.2",
    "prettier": "^3.6.0",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
