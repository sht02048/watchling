{
  "name": "watchling",
  "version": "0.3.0",
  "private": true,
  "description": "A quiet, read-only desktop companion for coding agent sessions",
  "license": "MIT",
  "type": "module",
  "main": ".vite/build/main.cjs",
  "scripts": {
    "package": "electron-forge package",
    "build:helper": "swift build --package-path native/hook-emitter -c release",
    "make": "electron-forge make && WATCHLING_UNFUSED=1 electron-forge package",
    "release": "electron-forge release",
    "typecheck": "tsc --noEmit",
    "start": "pnpm package && electron .",
    "dev": "electron-forge start",
    "playground": "node scripts/playground.mjs",
    "site:dev": "pnpm --filter watchling-site dev",
    "site:build": "pnpm --filter watchling-site build",
    "test:unit": "node --experimental-strip-types --test tests/unit/*.test.ts",
    "test:integration": "pnpm build:helper && node --experimental-strip-types --test tests/integration/*.test.ts",
    "test:packaged": "pnpm make && node --experimental-strip-types --test tests/packaged/*.test.ts",
    "test:e2e": "pnpm package && playwright test",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-dmg": "8.0.1",
    "@electron-forge/plugin-fuses": "8.0.1",
    "@electron-forge/plugin-vite": "8.0.1",
    "@electron-forge/publisher-github": "8.0.1",
    "@electron-forge/shared-types": "8.0.1",
    "@electron/fuses": "2.1.3",
    "@playwright/test": "1.64.1",
    "@types/node": "^24.0.0",
    "electron": "44.9.2",
    "esbuild": "0.28.2",
    "lefthook": "2.2.2",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "packageManager": "pnpm@10.33.0"
}
